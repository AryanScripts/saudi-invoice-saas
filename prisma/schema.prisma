generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// ============================================================
// ENUMS
// ============================================================

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserRole {
  BUSINESS_OWNER
  EMPLOYEE
  SUPER_ADMIN
}

enum InvoiceType {
  TAX_INVOICE
  SIMPLIFIED_TAX_INVOICE
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  CANCELLED
  DELETED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum FeatureCode {
  PHASE_1
  PHASE_2
  INVOICE_DELETE_PIN
}

enum FeatureEntitlementStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  REVOKED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum QrAccessLevel {
  PHASE_1
  PHASE_2
}

enum DocumentType {
  INVOICE_PDF
  OTHER
}

enum OtpPurpose {
  LOGIN
  EMAIL_CHANGE
  SECURITY_ACTION
  BUSINESS_OWNERSHIP
  FEATURE_CONFIGURATION
}


// ============================================================
// BUSINESSES / TENANTS
// ============================================================

model Business {
  id String @id @default(uuid()) @db.Uuid

  nameEn String
  nameAr String

  legalNameEn String?
  legalNameAr String?

  vatNumber String?
  commercialRegistrationNumber String?

  addressEn String?
  addressAr String?

  city String?
  country String? @default("Saudi Arabia")

  phone String?
  email String?
  logoUrl String?

  status BusinessStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users BusinessUser[]
  customers Customer[]
  productsServices ProductService[]
  invoices Invoice[]

  settings BusinessSettings?
  securitySettings BusinessSecuritySettings?

  featureEntitlements BusinessFeatureEntitlement[]
  payments Payment[]

  documents Document[]
  notifications Notification[]
  auditLogs AuditLog[]

  @@index([status])
  @@index([vatNumber])
  @@index([commercialRegistrationNumber])
  @@map("businesses")
}


// ============================================================
// USERS / IDENTITY
// ============================================================

model User {
  id String @id @default(uuid()) @db.Uuid

  authUserId String @unique

  email String @unique
  fullName String?
  phone String?

  status UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businesses BusinessUser[]

  createdInvoices Invoice[] @relation("InvoiceCreatedBy")

  otpVerifications OtpVerification[]
  sessions Session[]

  notifications Notification[]
  auditLogs AuditLog[]

  activatedEntitlements BusinessFeatureEntitlement[] @relation("EntitlementActivatedBy")

  verifiedPayments Payment[] @relation("PaymentVerifiedBy")

  @@index([email])
  @@index([status])
  @@map("users")
}


// ============================================================
// BUSINESS USERS / ROLES
// ============================================================

model BusinessUser {
  id String @id @default(uuid()) @db.Uuid

  businessId String @db.Uuid
  userId String @db.Uuid

  role UserRole
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId, role])
  @@index([userId])
  @@map("business_users")
}


// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id String @id @default(uuid()) @db.Uuid

  businessId String @db.Uuid

  nameEn String
  nameAr String?

  vatNumber String?

  phone String?
  email String?

  addressEn String?
  addressAr String?

  city String?
  country String? @default("Saudi Arabia")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  invoices Invoice[]

  @@index([businessId])
  @@index([businessId, isActive])
  @@index([businessId, vatNumber])
  @@map("customers")
}


// ============================================================
// PRODUCTS / SERVICES
// ============================================================

model ProductService {
  id String @id @default(uuid()) @db.Uuid

  businessId String @db.Uuid

  nameEn String
  nameAr String?

  descriptionEn String?
  descriptionAr String?

  type ProductServiceType

  sku String?
  unit String?

  price Decimal @db.Decimal(18, 2)
  vatRate Decimal @db.Decimal(5, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  invoiceItems InvoiceItem[]

  @@index([businessId])
  @@index([businessId, isActive])
  @@index([businessId, sku])
  @@map("products_services")
}

enum ProductServiceType {
  PRODUCT
  SERVICE
}


// ============================================================
// INVOICES
// ============================================================

model Invoice {
  id String @id @default(uuid()) @db.Uuid

  businessId String @db.Uuid
  customerId String? @db.Uuid

  invoiceNumber String

  invoiceType InvoiceType
  status InvoiceStatus @default(DRAFT)

  issueDate DateTime
  dueDate DateTime?

  subtotal Decimal @db.Decimal(18, 2)
  discountTotal Decimal @default(0) @db.Decimal(18, 2)
  taxableAmount Decimal @db.Decimal(18, 2)
  vatAmount Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  currency String @default("SAR")

  notesEn String?
  notesAr String?

  createdById String @db.Uuid

  finalizedAt DateTime?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdBy User @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  items InvoiceItem[]
  payments InvoicePayment[]

  qrCodes InvoiceQrCode[]

  documents Document[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, issueDate])
  @@index([customerId])
  @@map("invoices")
}


// ============================================================
// INVOICE ITEMS
// ============================================================

model InvoiceItem {
  id String @id @default(uuid()) @db.Uuid

  invoiceId String @db.Uuid
  productServiceId String? @db.Uuid

  descriptionEn String
  descriptionAr String?

  quantity Decimal @db.Decimal(18, 3)

  unitPrice Decimal @db.Decimal(18, 2)

  discount Decimal @default(0) @db.Decimal(18, 2)

  taxableAmount Decimal @db.Decimal(18, 2)
  vatAmount Decimal @db.Decimal(18, 2)
  lineTotal Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productService ProductService? @relation(fields: [productServiceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productServiceId])
  @@map("invoice_items")
}


// ============================================================
// INVOICE PAYMENTS
// ============================================================

model InvoicePayment {
  id String @id @default(uuid()) @db.Uuid

  invoiceId String @db.Uuid

  amount Decimal @db.Decimal(18, 2)

  method PaymentMethod

  paymentDate DateTime

  reference String?
  notes String?

  createdById String @db.Uuid

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([paymentDate])
  @@map("invoice_payments")
}


// ============================================================
// INVOICE QR CODES
// ============================================================

model InvoiceQrCode {
  id String @id @default(uuid()) @db.Uuid

  invoiceId String @db.Uuid

  qrVersion String
  accessLevel QrAccessLevel

  payload String @db.Text
  qrImageUrl String?

  generatedAt DateTime
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  tags InvoiceQrTag[]

  @@index([invoiceId])
  @@index([accessLevel])
  @@map("invoice_qr_codes")
}


// ============================================================
// QR TAGS
// ============================================================

model InvoiceQrTag {
  id String @id @default(uuid()) @db.Uuid

  qrCodeId String @db.Uuid

  tagNumber Int
  tagValue String @db.Text

  createdAt DateTime @default(now())

  qrCode InvoiceQrCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@unique([qrCodeId, tagNumber])
  @@index([qrCodeId])
  @@map("invoice_qr_tags")
}


// ============================================================
// FEATURES
// ============================================================

model Feature {
  id String @id @default(uuid()) @db.Uuid

  code FeatureCode @unique

  nameEn String
  nameAr String

  descriptionEn String?
  descriptionAr String?

  priceSar Decimal @db.Decimal(18, 2)

  durationDays Int @default(365)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entitlements BusinessFeatureEntitlement[]
  payments Payment[]

  @@index([isActive])
  @@map("features")
}


// ============================================================
// BUSINESS FEATURE ENTITLEMENTS
// ============================================================

model BusinessFeatureEntitlement {
  id String @id @default(uuid()) @db.Uuid

  businessId String @db.Uuid
  featureId String @db.Uuid

  status FeatureEntitlementStatus @default(ACTIVE)

  startsAt DateTime
  expiresAt DateTime

  activatedById String? @db.Uuid
  sourcePaymentId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  feature Feature @relation(fields: [featureId], references: [id])

  activatedBy User? @relation("EntitlementActivatedBy", fields: [activatedById], references: [id], onDelete: SetNull)

  sourcePayment Payment? @relation(fields: [sourcePaymentId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, featureId])
  @@index([businessId, status])
  @@index([expiresAt])
  @@map("business_feature_entitlements")
}


// ============================================================
// MANUAL PAYMENTS
// ============================================================

model Payment {
  id String @id @default(uuid()) @db.Uuid

  businessId String @db.Uuid
  featureId String @db.Uuid

  amountSar Decimal @db.Decimal(18, 2)

  paymentDate DateTime

  status PaymentStatus @default(PENDING)

  paymentReference String?
  receiptUrl String?

  notes String?

  verifiedById String? @db.Uuid
  verifiedAt DateTime?

  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  feature Feature @relation(fields: [featureId], references: [id])

  verifiedBy User? @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  entitlements BusinessFeatureEntitlement[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([featureId])
  @@index([status])
  @@map("payments")
}


// ============================================================
// BUSINESS SECURITY SETTINGS
// ============================================================

model BusinessSecuritySettings {
  id String @id @default(uuid()) @db.Uuid

  businessId String @unique @db.Uuid

  invoiceDeletePinHash String?

  pinEnabled Boolean @default(false)

  failedPinAttempts Int @default(0)
  lockedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_security_settings")
}


// ============================================================
// OTP VERIFICATIONS
// ============================================================

model OtpVerification {
  id String @id @default(uuid()) @db.Uuid

  userId String? @db.Uuid

  email String

  purpose OtpPurpose

  otpHash String

  expiresAt DateTime
  consumedAt DateTime?

  attempts Int @default(0)

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([email, purpose])
  @@index([userId])
  @@index([expiresAt])
  @@map("otp_verifications")
}


// ============================================================
// SESSIONS
// ============================================================

model Session {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  sessionTokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}


// ============================================================
// BUSINESS SETTINGS
// ============================================================

model BusinessSettings {
  id String @id @default(uuid()) @db.Uuid

  businessId String @unique @db.Uuid

  invoicePrefix String @default("INV")

  nextInvoiceNumber Int @default(1)

  defaultVatRate Decimal @default(15) @db.Decimal(5, 2)

  defaultCurrency String @default("SAR")

  footerEn String?
  footerAr String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_settings")
}


// ============================================================
// DOCUMENTS
// ============================================================

model Document {
  id String @id @default(uuid()) @db.Uuid

  businessId String @db.Uuid
  invoiceId String? @db.Uuid

  type DocumentType

  storagePath String
  filename String
  mimeType String

  createdAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([invoiceId])
  @@index([type])
  @@map("documents")
}


// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String? @db.Uuid
  businessId String? @db.Uuid

  type String

  titleEn String
  titleAr String

  messageEn String
  messageAr String

  readAt DateTime?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([businessId])
  @@index([readAt])
  @@map("notifications")
}


// ============================================================
// AUDIT LOGS
// ============================================================

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  businessId String? @db.Uuid
  userId String? @db.Uuid

  action String

  entityType String
  entityId String?

  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}